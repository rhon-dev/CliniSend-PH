# CliniSend PH backend environment — TEMPLATE ONLY
#
# Copy to `backend/.env` and fill in real values locally. Never commit `.env`
# (it is gitignored). Secrets live only in environment variables (R14.3) and
# never in source or the client bundle. Staging and production use separate
# Supabase projects and separate values (R14.10).

# Deployment environment: local | staging | production
# Drives the seed gate (R15.4) — seeding runs only for local or staging.
APP_ENV=local

# Port the Express server binds to.
PORT=8080

# Exact frontend origins allowed by CORS, comma separated. No wildcard (R14.12).
# Example: https://app.clinisend.example,https://staging.clinisend.example
ALLOWED_ORIGINS=http://localhost:5173

# Supabase project — SERVER SIDE ONLY.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key BYPASSES Row-Level Security. Server-side only. It must never
# be sent to the browser or checked into source (R2.10, R14.5).
SUPABASE_SERVICE_ROLE_KEY=
