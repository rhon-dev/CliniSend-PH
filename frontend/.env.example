# CliniSend PH frontend environment — TEMPLATE ONLY
#
# Copy to `frontend/.env` and fill in real values locally. Never commit `.env`.
#
# Only the Supabase project URL and the ANON key belong in the client bundle
# (R14.5). The service role key must NEVER appear here — Vite would inline any
# VITE_-prefixed value into the shipped bundle.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
